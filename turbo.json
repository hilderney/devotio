{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "env": ["VITE_CONVEX_URL", "VITE_CONVEX_SITE_URL"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
