{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@devocional/backend/*": ["packages/backend/src/*"],
      "@devocional/domain/*": ["packages/domain/src/*"],
      "@devocional/ui-kit/*": ["packages/ui-kit/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "build"]
}