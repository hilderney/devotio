{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [],
    "rootDir": "."
  },
  "include": [
    "index.ts",
    "copy/**/*.ts",
    "date/**/*.ts",
    "hooks/**/*.ts",
    "types/**/*.ts",
    "validators/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
