{
  "name": "devotio-monorepo",
  "private": true,
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "setup:local": "node scripts/prepare-local.mjs",
    "verify:local": "node scripts/verify-local.mjs",
    "build": "turbo run build",
    "lint": "turbo run lint && eslint scripts",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "verify:web": "npm run build && node scripts/verify-web-build.mjs",
    "deploy:web": "npm run build --workspace=web && npm run deploy --workspace=web"
  },
  "devDependencies": {
    "convex": "^1.46.0",
    "wrangler": "^4.42.0",
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.48.0",
    "globals": "^16.5.0",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  }
}
